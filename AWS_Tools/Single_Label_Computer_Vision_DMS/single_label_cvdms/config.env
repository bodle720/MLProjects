# -------------------------------
# Global settings
# -------------------------------

# AWS region to deploy into
AWS_REGION=us-east-1

# Name of the S3 bucket to hold all datasets/images
S3_BUCKET_NAME=my-dataset-bucket

# Root folder inside the bucket for all dataset content
# Images will always live under <bucket>/<S3_DATASETS_ROOT>/images/
S3_DATASETS_ROOT=single-label-cv-datasets

# -------------------------------
# SQS Queues
# -------------------------------

# Queue for dataset lifecycle events:
# (register dataset, add class, remove class, delete dataset)
SQS_QUEUE_LIFECYCLE=dataset-lifecycle-queue

# Queue for image operations:
# (upload images, remove images)
SQS_QUEUE_IMAGE_OPS=dataset-image-ops-queue

# Queue for manifest sync jobs
SQS_QUEUE_SYNC=dataset-sync-queue

# Shared dead-letter queue
SQS_QUEUE_DLQ=dataset-dlq

# -------------------------------
# Lambda Functions
# -------------------------------

# Worker Lambda for lifecycle events
LAMBDA_LIFECYCLE=dataset-lifecycle-worker

# Worker Lambda for image operations
LAMBDA_IMAGE_OPS=dataset-image-ops-worker

# Worker Lambda for manifest sync
LAMBDA_SYNC=dataset-manifest-sync

# Lambda name to handle DQ messages
LAMBDA_DLQ=dlq-lambda

# -------------------------------
# DynamoDB Tables
# -------------------------------

# Table tracking which datasets reference which images
DDB_IMAGERY_TABLE=ImageryTable

# Table holding dataset metadata, lock state, and manifest flags
DDB_DATASET_TABLE=DatasetTable

# Table tracking jobs (audit trail of operations)
DDB_JOB_TABLE=JobTable

# -------------------------------
# Execution Role Names for Lambdas
# -------------------------------
LIFECYCLE_ROLE_NAME=exec-role-lifecycle
IMAGE_OPS_ROLE_NAME=exec-role-img-ops
SYNC_ROLE_NAME=exec-role-sync
DLQ_ROLE_NAME=exec-role-sync


# ------------------------------
# Lambda image names.
# ------------------------------
IMAGE_NAME_LIFECYCLE=img-lifecycle
IMAGE_NAME_IMAGE_OPS=img-img-ops
IMAGE_NAME_SYNC=img-sync
IMAGE_NAME_DLQ=img-dlq